# Additional Xbox 360 Xenon VMX128 arithmetic, comparison, conversion,
# packing, and indexed memory forms.
#
# Reuse Ghidra 12.1.2's existing AltiVec p-code operations whenever the Xenon
# instruction has the same element-level behavior with an extended register
# namespace. Xenon-specific D3D pack/unpack behavior, compare-record side
# effects, and partial store-right behavior remain named userops so they are not
# silently replaced with guessed semantics.

define pcodeop xenon_vupkd3d128;
define pcodeop xenon_vpkd3d128;
define pcodeop xenon_vmx128_record;
define pcodeop xenon_stvrx_partial;

# VX128 multiply-add forms. Xenon reuses the old destination as an input:
# vmaddfp128  VD = (VA * VB) + VD
# vmaddcfp128 VD = (VA * VD) + VB
:vmaddfp128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=3 & XENON_BIT_4=1
{
    xvD = vectorMultiplyAddFloatingPoint(xvA,xvB,xvD);
}

:vmaddcfp128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=4 & XENON_BIT_4=1
{
    xvD = vectorMultiplyAddFloatingPoint(xvA,xvD,xvB);
}

# VX128_3 one-source floating-point estimates / unpack / conversions.
:vrefp128 xvD,xvB
    is OP=6 & xvD & xvB & XENON_BITS_4_10=99
{
    xvD = vectorReciprocalEstimateFloatingPoint(xvB);
}

:vupkd3d128 xvD,xvB,A_BITS
    is OP=6 & xvD & xvB & A_BITS & XENON_BITS_4_10=127
{
    xvD = xenon_vupkd3d128(xvB,A_BITS:1);
}

:vrsqrtefp128 xvD,xvB
    is OP=6 & xvD & xvB & XENON_BITS_4_10=103
{
    xvD = vectorReciprocalSquareRootEstimateFloatingPoint(xvB);
}

:vcuxwfp128 xvD,xvB,A_BITS
    is OP=6 & xvD & xvB & A_BITS & XENON_BITS_4_10=47
{
    xvD = vectorConvertFromUnsignedFixedPointWord(xvB,A_BITS:1);
}

:vcfpsxws128 xvD,xvB,A_BITS
    is OP=6 & xvD & xvB & A_BITS & XENON_BITS_4_10=35
{
    xvD = vectorConvertToSignedFixedPointWordSaturate(xvB,A_BITS:1);
}

:vlogefp128 xvD,xvB
    is OP=6 & xvD & xvB & XENON_BITS_4_10=111
{
    xvD = vectorLog2EstimateFloatingPoint(xvB);
}

:vexptefp128 xvD,xvB
    is OP=6 & xvD & xvB & XENON_BITS_4_10=107
{
    xvD = vector2RaisedToTheExponentEstimateFloatingPoint(xvB);
}

# VX128 arithmetic/logical forms.
# Signed halfword subtype: encoded VA=0x60, not a source register.
# Exact mask 0xfc1f07f0; see docs/VMX128_UNPACK.md.
:vupkhsh128 xvD,xvB
    is OP=6 & xvD & xvB & XENON_BITS_6_9=14 & XENON_BIT_4=0 & A=0 & XENON_BIT_5=1 & BIT_10=1
{
    # ADD-zero snapshot preserves high lanes in the 12.1.4 optimizer.
    zero:16 = zext(0:4);
    source:16 = xvB + zero;
    half0:2 = source(14);
    word0:4 = sext(half0);
    half1:2 = source(12);
    word1:4 = sext(half1);
    half2:2 = source(10);
    word2:4 = sext(half2);
    half3:2 = source(8);
    word3:4 = sext(half3);
    local result:16;
    result[96,32] = word0;
    result[64,32] = word1;
    result[32,32] = word2;
    result[0,32] = word3;
    xvD = result;
}

:vupkhsb128 xvD,xvB
    is OP=6 & xvD & xvB & XENON_BITS_6_9=14 & XENON_BIT_4=0
{
    xvD = vectorUnpackHighSignedByte(xvB);
}

:vsrw128 xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=7 & XENON_BIT_4=1
{
    xvD = vectorShiftRightWord(xvA,xvB);
}

:vmaxfp128 xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=10 & XENON_BIT_4=0
{
    xvD = vectorMaximumFloatingPoint(xvA,xvB);
}

:vmrglw128 xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=13 & XENON_BIT_4=0
{
    # Guest words 2 and 3 from the same qualified snapshot form as the high merge.
    zero:16 = zext(0:4);
    a:16 = xvA + zero;
    b:16 = xvB + zero;
    a2:4 = a[32,32];
    a3:4 = a[0,32];
    b2:4 = b[32,32];
    b3:4 = b[0,32];
    local result:16;
    result[96,32] = a2;
    result[64,32] = b2;
    result[32,32] = a3;
    result[0,32] = b3;
    xvD = result;
}

:vslw128 xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=3 & XENON_BIT_4=1
{
    xvD = vectorShiftLeftIntegerWord(xvA,xvB);
}

:vand128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=8 & XENON_BIT_4=1
{
    xvD = xvA & xvB;
}

# VX128_R compare forms. In this encoding bit 6 is the record bit and bits
# 7..9 are the fixed extended opcode. Reuse XENON_BITS_6_9 so no additional
# token-field patch is required: even values are non-record forms, odd values
# are record forms. The vector result uses Ghidra's existing AltiVec compare
# semantics. Record forms additionally call an opaque side-effect userop so a
# CR update is not silently discarded (stock Ghidra leaves equivalent CR6
# behavior as TODO for several AltiVec record compares).
:vcmpeqfp128 xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=0 & XENON_BIT_4=0
{
    xvD = vectorCompareEqualToFloatingPoint(xvA,xvB);
}

:vcmpeqfp128. xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=1 & XENON_BIT_4=0
{
    xvD = vectorCompareEqualToFloatingPoint(xvA,xvB);
    xenon_vmx128_record(xvD);
}

:vcmpgefp128 xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=2 & XENON_BIT_4=0
{
    xvD = vectorCompareGreaterThanOrEqualToFloatingPoint(xvA,xvB);
}

:vcmpgefp128. xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=3 & XENON_BIT_4=0
{
    xvD = vectorCompareGreaterThanOrEqualToFloatingPoint(xvA,xvB);
    xenon_vmx128_record(xvD);
}

:vcmpgtfp128 xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=4 & XENON_BIT_4=0
{
    xvD = vectorCompareGreaterThanFloatingPoint(xvA,xvB);
}

:vcmpgtfp128. xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=5 & XENON_BIT_4=0
{
    xvD = vectorCompareGreaterThanFloatingPoint(xvA,xvB);
    xenon_vmx128_record(xvD);
}

# Exact integer-word equality and its CR6 reduction. Keep all inherited userop
# declarations in place: their numbering is a compatibility interface.
# Guest word zero occupies the most-significant 32 bits of the vector.
macro xenonCompareEqualWord(result, inputA, inputB) {
    # The ADD-zero snapshot also supports the qualified 12.1.4 optimizer.
    zero:16 = zext(0:4);
    a:16 = inputA + zero;
    b:16 = inputB + zero;
    a0:4 = a(12); b0:4 = b(12);
    a1:4 = a(8);  b1:4 = b(8);
    a2:4 = a(4);  b2:4 = b(4);
    a3:4 = a(0);  b3:4 = b(0);
    w0:4 = 0 - zext(a0 == b0);
    w1:4 = 0 - zext(a1 == b1);
    w2:4 = 0 - zext(a2 == b2);
    w3:4 = 0 - zext(a3 == b3);
    local assembled:16;
    assembled[96,32] = w0;
    assembled[64,32] = w1;
    assembled[32,32] = w2;
    assembled[0,32] = w3;
    result = assembled;
}

:vcmpequw128 xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=8 & XENON_BIT_4=0
{
    local result:16;
    xenonCompareEqualWord(result,xvA,xvB);
    xvD = result;
}

:vcmpequw128. xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=9 & XENON_BIT_4=0
{
    local result:16;
    xenonCompareEqualWord(result,xvA,xvB);
    allOnes:16 = ~zext(0:4);
    all:1 = result == allOnes;
    none:1 = result == 0;
    # CR[24:27] = all || 0 || none || 0. Preserve model padding bits.
    cr6 = (cr6 & 0xf0) | (all << 3) | (none << 1);
    xvD = result;
}

# VX128_4 D3D pack. IMM is the five-bit x/y control field and z occupies
# bits 6..7. Include the old destination as a conservative architectural input
# to the opaque pack userop rather than discarding possible insert semantics.
:vpkd3d128 xvD,xvB,A_BITS,XENON_BITS_6_7
    is OP=6 & xvD & xvB & A_BITS & XENON_BITS_6_7 & XENON_BITS_8_10=6 & BITS_4_5=1
{
    xvD = xenon_vpkd3d128(xvD,xvB,A_BITS:1,XENON_BITS_6_7:1);
}

# VX128_1 store-vector-element-word. Guest word zero is the most-significant
# 32 bits of xvR. Address bits 2..3 select the guest word; low bits 0..1 are
# ignored for both selection and the four-byte store. The language's ram
# truncate_space retains the existing 32-bit effective-address behavior.
:stvewx128 xvR,RA_OR_ZERO,RB
    is OP=4 & xvR & RA_OR_ZERO & RB & BITS_6_10=6 & BITS_4_5=0
{
    EA:$(REGISTER_SIZE) = (RA_OR_ZERO + RB) & 0xfffffffffffffffc;
    word_shift:1 = (12 - (EA:1 & 12)) * 8;
    selected:16 = xvR >> word_shift;
    *[ram]:4 EA = selected:4;
}

# Cell/VMX store-vector-right indexed. This is a standard AltiVec/Cell form,
# not VMX128, but the derived Ghidra 12.1.2 language does not decode the one
# required form. Native p-code preserves untouched bytes; an aligned store is a no-op.
:stvrx vrS,RA_OR_ZERO,B
    is OP=31 & vrS & RA_OR_ZERO & B & XOP_1_10=679 & Rc=0
{
    ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    eb:1 = ea[0,4];
    if (eb == 0) goto <done>;
    aligned:$(REGISTER_SIZE) = ea & 0xfffffffffffffff0;
    old_block:16 = *[ram]:16 aligned;
    shift:1 = 128 - eb * 8;
    mask:16 = sext(-1:8);
    mask = mask << shift;
    new_block:16 = (old_block & ~mask) | ((vrS << shift) & mask);
    *[ram]:16 aligned = new_block;
    <done>
}
