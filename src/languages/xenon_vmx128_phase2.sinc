# Additional Xbox 360 Xenon VMX128 arithmetic, permutation, conversion,
# and indexed memory forms.
#
# Straightforward operations reuse Ghidra's existing AltiVec p-code userops
# or exact integer p-code. More complex VMX128 operations use named Xenon
# userops with correct source/destination dependencies instead of fake no-op
# semantics. lvlx/stvlx also preserve their aligned memory dependencies.

define pcodeop xenon_vmulfp128;
define pcodeop xenon_vmsum3fp128;
define pcodeop xenon_vmsum4fp128;
define pcodeop xenon_vperm128;
define pcodeop xenon_vpermwi128;
define pcodeop xenon_vrlimi128;
define pcodeop xenon_lvlx_partial;
define pcodeop xenon_stvlx_partial;

# Full 7-bit VMX128 operands for the VX128-family formats.
