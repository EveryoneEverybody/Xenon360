xvA: "v1" is A=1 & XENON_BIT_5=0 & BIT_10=0 { export vs33; }
xvA: "v2" is A=2 & XENON_BIT_5=0 & BIT_10=0 { export vs34; }
xvA: "v3" is A=3 & XENON_BIT_5=0 & BIT_10=0 { export vs35; }
