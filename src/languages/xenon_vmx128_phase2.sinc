xvA: "v62" is A=30 & XENON_BIT_5=1 & BIT_10=0 { export v62; }
xvA: "v63" is A=31 & XENON_BIT_5=1 & BIT_10=0 { export v63; }
xvA: "v64" is A=0 & XENON_BIT_5=0 & BIT_10=1 { export v64; }
xvA: "v65" is A=1 & XENON_BIT_5=0 & BIT_10=1 { export v65; }
xvA: "v66" is A=2 & XENON_BIT_5=0 & BIT_10=1 { export v66; }
xvA: "v67" is A=3 & XENON_BIT_5=0 & BIT_10=1 { export v67; }
xvA: "v68" is A=4 & XENON_BIT_5=0 & BIT_10=1 { export v68; }
xvA: "v69" is A=5 & XENON_BIT_5=0 & BIT_10=1 { export v69; }
xvA: "v70" is A=6 & XENON_BIT_5=0 & BIT_10=1 { export v70; }
xvA: "v71" is A=7 & XENON_BIT_5=0 & BIT_10=1 { export v71; }
xvA: "v72" is A=8 & XENON_BIT_5=0 & BIT_10=1 { export v72; }
xvA: "v73" is A=9 & XENON_BIT_5=0 & BIT_10=1 { export v73; }
xvA: "v74" is A=10 & XENON_BIT_5=0 & BIT_10=1 { export v74; }
xvA: "v75" is A=11 & XENON_BIT_5=0 & BIT_10=1 { export v75; }
xvA: "v76" is A=12 & XENON_BIT_5=0 & BIT_10=1 { export v76; }
xvA: "v77" is A=13 & XENON_BIT_5=0 & BIT_10=1 { export v77; }
xvA: "v78" is A=14 & XENON_BIT_5=0 & BIT_10=1 { export v78; }
xvA: "v79" is A=15 & XENON_BIT_5=0 & BIT_10=1 { export v79; }
xvA: "v80" is A=16 & XENON_BIT_5=0 & BIT_10=1 { export v80; }
xvA: "v81" is A=17 & XENON_BIT_5=0 & BIT_10=1 { export v81; }
xvA: "v82" is A=18 & XENON_BIT_5=0 & BIT_10=1 { export v82; }
xvA: "v83" is A=19 & XENON_BIT_5=0 & BIT_10=1 { export v83; }
xvA: "v84" is A=20 & XENON_BIT_5=0 & BIT_10=1 { export v84; }
xvA: "v85" is A=21 & XENON_BIT_5=0 & BIT_10=1 { export v85; }
xvA: "v86" is A=22 & XENON_BIT_5=0 & BIT_10=1 { export v86; }
xvA: "v87" is A=23 & XENON_BIT_5=0 & BIT_10=1 { export v87; }
xvA: "v88" is A=24 & XENON_BIT_5=0 & BIT_10=1 { export v88; }
xvA: "v89" is A=25 & XENON_BIT_5=0 & BIT_10=1 { export v89; }
xvA: "v90" is A=26 & XENON_BIT_5=0 & BIT_10=1 { export v90; }
xvA: "v91" is A=27 & XENON_BIT_5=0 & BIT_10=1 { export v91; }
xvA: "v92" is A=28 & XENON_BIT_5=0 & BIT_10=1 { export v92; }
xvA: "v93" is A=29 & XENON_BIT_5=0 & BIT_10=1 { export v93; }
xvA: "v94" is A=30 & XENON_BIT_5=0 & BIT_10=1 { export v94; }
xvA: "v95" is A=31 & XENON_BIT_5=0 & BIT_10=1 { export v95; }
xvA: "v96" is A=0 & XENON_BIT_5=1 & BIT_10=1 { export v96; }
xvA: "v97" is A=1 & XENON_BIT_5=1 & BIT_10=1 { export v97; }
xvA: "v98" is A=2 & XENON_BIT_5=1 & BIT_10=1 { export v98; }
xvA: "v99" is A=3 & XENON_BIT_5=1 & BIT_10=1 { export v99; }
xvA: "v100" is A=4 & XENON_BIT_5=1 & BIT_10=1 { export v100; }
xvA: "v101" is A=5 & XENON_BIT_5=1 & BIT_10=1 { export v101; }
xvA: "v102" is A=6 & XENON_BIT_5=1 & BIT_10=1 { export v102; }
xvA: "v103" is A=7 & XENON_BIT_5=1 & BIT_10=1 { export v103; }
xvA: "v104" is A=8 & XENON_BIT_5=1 & BIT_10=1 { export v104; }
xvA: "v105" is A=9 & XENON_BIT_5=1 & BIT_10=1 { export v105; }
xvA: "v106" is A=10 & XENON_BIT_5=1 & BIT_10=1 { export v106; }
xvA: "v107" is A=11 & XENON_BIT_5=1 & BIT_10=1 { export v107; }
xvA: "v108" is A=12 & XENON_BIT_5=1 & BIT_10=1 { export v108; }
xvA: "v109" is A=13 & XENON_BIT_5=1 & BIT_10=1 { export v109; }
xvA: "v110" is A=14 & XENON_BIT_5=1 & BIT_10=1 { export v110; }
xvA: "v111" is A=15 & XENON_BIT_5=1 & BIT_10=1 { export v111; }
xvA: "v112" is A=16 & XENON_BIT_5=1 & BIT_10=1 { export v112; }
xvA: "v113" is A=17 & XENON_BIT_5=1 & BIT_10=1 { export v113; }
xvA: "v114" is A=18 & XENON_BIT_5=1 & BIT_10=1 { export v114; }
xvA: "v115" is A=19 & XENON_BIT_5=1 & BIT_10=1 { export v115; }
xvA: "v116" is A=20 & XENON_BIT_5=1 & BIT_10=1 { export v116; }
xvA: "v117" is A=21 & XENON_BIT_5=1 & BIT_10=1 { export v117; }
xvA: "v118" is A=22 & XENON_BIT_5=1 & BIT_10=1 { export v118; }
xvA: "v119" is A=23 & XENON_BIT_5=1 & BIT_10=1 { export v119; }
xvA: "v120" is A=24 & XENON_BIT_5=1 & BIT_10=1 { export v120; }
xvA: "v121" is A=25 & XENON_BIT_5=1 & BIT_10=1 { export v121; }
xvA: "v122" is A=26 & XENON_BIT_5=1 & BIT_10=1 { export v122; }
xvA: "v123" is A=27 & XENON_BIT_5=1 & BIT_10=1 { export v123; }
xvA: "v124" is A=28 & XENON_BIT_5=1 & BIT_10=1 { export v124; }
xvA: "v125" is A=29 & XENON_BIT_5=1 & BIT_10=1 { export v125; }
xvA: "v126" is A=30 & XENON_BIT_5=1 & BIT_10=1 { export v126; }
xvA: "v127" is A=31 & XENON_BIT_5=1 & BIT_10=1 { export v127; }

# vperm128 has a three-bit control-vector field.
xvC: "v0" is XENON_BITS_6_8=0 { export vs32; }
xvC: "v1" is XENON_BITS_6_8=1 { export vs33; }
xvC: "v2" is XENON_BITS_6_8=2 { export vs34; }
xvC: "v3" is XENON_BITS_6_8=3 { export vs35; }
xvC: "v4" is XENON_BITS_6_8=4 { export vs36; }
xvC: "v5" is XENON_BITS_6_8=5 { export vs37; }
xvC: "v6" is XENON_BITS_6_8=6 { export vs38; }
xvC: "v7" is XENON_BITS_6_8=7 { export vs39; }

# Immediate operands whose underlying instruction fields otherwise overlap
# PowerPC GPR selector fields.
xvUIMM5: imm is A [ imm = A; ] { tmp:1 = imm; export tmp; }
xvSH4: sh is XENON_BITS_6_9 [ sh = XENON_BITS_6_9; ] { tmp:1 = sh; export tmp; }
xvZ2: z is XENON_BITS_6_7 [ z = XENON_BITS_6_7; ] { tmp:1 = z; export tmp; }
xvPERM: perm is A & XENON_BITS_6_8 [ perm = A | (XENON_BITS_6_8 << 5); ] { tmp:1 = perm; export tmp; }

# VX128 arithmetic/logical forms.
:vaddfp128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=0 & XENON_BIT_4=1
{
    xvD = vectorAddFloatingPoint(xvA,xvB);
}

:vsubfp128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=1 & XENON_BIT_4=1
{
    xvD = vectorSubtractFloatingPoint(xvA,xvB);
}

:vmulfp128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=2 & XENON_BIT_4=1
{
    xvD = xenon_vmulfp128(xvA,xvB);
}

:vmsum3fp128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=6 & XENON_BIT_4=1
{
    xvD = xenon_vmsum3fp128(xvA,xvB);
}

:vmsum4fp128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=7 & XENON_BIT_4=1
{
    xvD = xenon_vmsum4fp128(xvA,xvB);
}

:vor128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=11 & XENON_BIT_4=1
{
    xvD = xvA | xvB;
}

:vxor128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=12 & XENON_BIT_4=1
{
    xvD = xvA ^ xvB;
}

:vsel128 xvD,xvA,xvB
    is OP=5 & xvD & xvA & xvB & XENON_BITS_6_9=13 & XENON_BIT_4=1
{
    mask:16 = xvD;
    xvD = (xvA & ~mask) | (xvB & mask);
}

:vminfp128 xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=11 & XENON_BIT_4=0
{
    xvD = vectorMinimumFloatingPoint(xvA,xvB);
}

:vmrghw128 xvD,xvA,xvB
    is OP=6 & xvD & xvA & xvB & XENON_BITS_6_9=12 & XENON_BIT_4=0
{
    xvD = vectorMergeHighWord(xvA,xvB);
}

# VX128_2 byte permutation. VC is a three-bit vector register.
:vperm128 xvD,xvA,xvB,xvC
    is OP=5 & xvD & xvA & xvB & xvC & BIT_9=0 & XENON_BIT_4=0
{
    xvD = xenon_vperm128(xvA,xvB,xvC);
}

# VX128_P word permutation immediate.
:vpermwi128 xvD,xvB,xvPERM
    is OP=6 & xvD & xvB & xvPERM & XENON_BITS_9_10=1 & BITS_4_5=1
{
    xvD = xenon_vpermwi128(xvB,xvPERM);
}

# VX128_4 rotate-left-immediate-and-mask-insert. The old destination is an
# architectural input, so pass it explicitly to the opaque semantic userop.
:vrlimi128 xvD,xvB,xvUIMM5,xvZ2
    is OP=6 & xvD & xvB & xvUIMM5 & xvZ2 & XENON_BITS_8_10=7 & BITS_4_5=1
{
    xvD = xenon_vrlimi128(xvD,xvB,xvUIMM5,xvZ2);
}

# VX128_5 shift-left-double-by-octet-immediate.
:vsldoi128 xvD,xvA,xvB,xvSH4
    is OP=4 & xvD & xvA & xvB & xvSH4 & XENON_BIT_4=1
{
    xvD = vectorShiftLeftDoubleByOctetImmediate(xvA,xvB,xvSH4);
}

# VX128_3 forms.
:vspltisw128 xvD,A_BITSS
    is OP=6 & xvD & A_BITSS & XENON_BITS_4_10=119
{
    xvD = vectorSplatImmediateSignedWord(A_BITSS:1);
}

:vspltw128 xvD,xvB,xvUIMM5
    is OP=6 & xvD & xvB & xvUIMM5 & XENON_BITS_4_10=115
{
    xvD = vectorSplatWord(xvB,xvUIMM5);
}

:vcsxwfp128 xvD,xvB,xvUIMM5
    is OP=6 & xvD & xvB & xvUIMM5 & XENON_BITS_4_10=43
{
    xvD = vectorConvertFromSignedFixedPointWord(xvB,xvUIMM5);
}

# Cell/VMX partial indexed vector loads/stores are not VMX128 opcodes, but
# are included here because Ghidra's base PowerPC language does not decode them.
# The userops preserve the aligned memory block and byte-offset dependency
# without inventing an incorrect byte-permutation implementation.
:lvlx vrD,RA_OR_ZERO,B
    is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=519 & Rc=0
{
    ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    eb:1 = ea[0,4];
    aligned:$(REGISTER_SIZE) = ea & 0xfffffffffffffff0;
    block:16 = *[ram]:16 aligned;
    vrD = xenon_lvlx_partial(block,eb);
}

:stvlx vrS,RA_OR_ZERO,B
    is OP=31 & vrS & RA_OR_ZERO & B & XOP_1_10=647 & Rc=0
{
    ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
    eb:1 = ea[0,4];
    aligned:$(REGISTER_SIZE) = ea & 0xfffffffffffffff0;
    old_block:16 = *[ram]:16 aligned;
    new_block:16 = xenon_stvlx_partial(old_block,vrS,eb);
    *[ram]:16 aligned = new_block;
}
