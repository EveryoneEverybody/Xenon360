xvA: "v13" is A=13 & XENON_BIT_5=0 & BIT_10=0 { export vs45; }
xvA: "v14" is A=14 & XENON_BIT_5=0 & BIT_10=0 { export vs46; }
xvA: "v15" is A=15 & XENON_BIT_5=0 & BIT_10=0 { export vs47; }
xvA: "v16" is A=16 & XENON_BIT_5=0 & BIT_10=0 { export vs48; }
xvA: "v17" is A=17 & XENON_BIT_5=0 & BIT_10=0 { export vs49; }
xvA: "v18" is A=18 & XENON_BIT_5=0 & BIT_10=0 { export vs50; }
xvA: "v19" is A=19 & XENON_BIT_5=0 & BIT_10=0 { export vs51; }
xvA: "v20" is A=20 & XENON_BIT_5=0 & BIT_10=0 { export vs52; }
xvA: "v21" is A=21 & XENON_BIT_5=0 & BIT_10=0 { export vs53; }
xvA: "v22" is A=22 & XENON_BIT_5=0 & BIT_10=0 { export vs54; }
xvA: "v23" is A=23 & XENON_BIT_5=0 & BIT_10=0 { export vs55; }
xvA: "v24" is A=24 & XENON_BIT_5=0 & BIT_10=0 { export vs56; }
