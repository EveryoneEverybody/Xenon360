xvA: "v26" is A=26 & XENON_BIT_5=0 & BIT_10=0 { export vs58; }
xvA: "v27" is A=27 & XENON_BIT_5=0 & BIT_10=0 { export vs59; }
xvA: "v28" is A=28 & XENON_BIT_5=0 & BIT_10=0 { export vs60; }
xvA: "v29" is A=29 & XENON_BIT_5=0 & BIT_10=0 { export vs61; }
xvA: "v30" is A=30 & XENON_BIT_5=0 & BIT_10=0 { export vs62; }
xvA: "v31" is A=31 & XENON_BIT_5=0 & BIT_10=0 { export vs63; }
