xvR: "v61" is BITS_0_3=7 & D=29 { export v61; }
xvR: "v62" is BITS_0_3=7 & D=30 { export v62; }
xvR: "v63" is BITS_0_3=7 & D=31 { export v63; }
xvR: "v64" is BITS_0_3=11 & D=0 { export v64; }
xvR: "v65" is BITS_0_3=11 & D=1 { export v65; }
