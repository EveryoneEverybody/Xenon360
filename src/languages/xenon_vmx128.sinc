# Xbox 360 Xenon VMX128 register and indexed load/store support.
#
# VX128_1 register encoding:
#   low five vector-register bits: D (instruction bits 21..25)
#   high two vector-register bits: instruction bits 2..3
#   instruction bits 0..1: fixed to 0b11
#
# v0..v31 alias the existing AltiVec/VSX storage (vs32..vs63).
# v32..v127 are Xenon-only architectural registers.

define register offset=0xA000 size=16 [
    v32 v33 v34 v35 v36 v37 v38 v39
    v40 v41 v42 v43 v44 v45 v46 v47
    v48 v49 v50 v51 v52 v53 v54 v55
    v56 v57 v58 v59 v60 v61 v62 v63
    v64 v65 v66 v67 v68 v69 v70 v71
    v72 v73 v74 v75 v76 v77 v78 v79
    v80 v81 v82 v83 v84 v85 v86 v87
    v88 v89 v90 v91 v92 v93 v94 v95
    v96 v97 v98 v99 v100 v101 v102 v103
    v104 v105 v106 v107 v108 v109 v110 v111
    v112 v113 v114 v115 v116 v117 v118 v119
    v120 v121 v122 v123 v124 v125 v126 v127
];

# 7-bit VMX128 destination/source vector operand.
xvR: "v0" is BITS_0_3=3 & D=0 { export vs32; }
xvR: "v1" is BITS_0_3=3 & D=1 { export vs33; }
xvR: "v2" is BITS_0_3=3 & D=2 { export vs34; }
xvR: "v3" is BITS_0_3=3 & D=3 { export vs35; }
xvR: "v4" is BITS_0_3=3 & D=4 { export vs36; }
xvR: "v5" is BITS_0_3=3 & D=5 { export vs37; }
xvR: "v6" is BITS_0_3=3 & D=6 { export vs38; }
xvR: "v7" is BITS_0_3=3 & D=7 { export vs39; }
xvR: "v8" is BITS_0_3=3 & D=8 { export vs40; }
xvR: "v9" is BITS_0_3=3 & D=9 { export vs41; }
xvR: "v10" is BITS_0_3=3 & D=10 { export vs42; }
xvR: "v11" is BITS_0_3=3 & D=11 { export vs43; }
xvR: "v12" is BITS_0_3=3 & D=12 { export vs44; }
xvR: "v13" is BITS_0_3=3 & D=13 { export vs45; }
xvR: "v14" is BITS_0_3=3 & D=14 { export vs46; }
xvR: "v15" is BITS_0_3=3 & D=15 { export vs47; }
xvR: "v16" is BITS_0_3=3 & D=16 { export vs48; }
xvR: "v17" is BITS_0_3=3 & D=17 { export vs49; }
xvR: "v18" is BITS_0_3=3 & D=18 { export vs50; }
xvR: "v19" is BITS_0_3=3 & D=19 { export vs51; }
xvR: "v20" is BITS_0_3=3 & D=20 { export vs52; }
xvR: "v21" is BITS_0_3=3 & D=21 { export vs53; }
xvR: "v22" is BITS_0_3=3 & D=22 { export vs54; }
xvR: "v23" is BITS_0_3=3 & D=23 { export vs55; }
xvR: "v24" is BITS_0_3=3 & D=24 { export vs56; }
xvR: "v25" is BITS_0_3=3 & D=25 { export vs57; }
xvR: "v26" is BITS_0_3=3 & D=26 { export vs58; }
xvR: "v27" is BITS_0_3=3 & D=27 { export vs59; }
