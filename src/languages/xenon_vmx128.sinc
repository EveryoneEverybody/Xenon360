# Xenia models lvx128/stvx128 with the same indexed effective-address
# behavior as lvx/stvx: RA==0 contributes zero and the address is aligned
# down to a 16-byte boundary.
:lvx128 xvR, RA_OR_ZERO, RB
    is OP=4 & xvR & RA_OR_ZERO & RB & BITS_6_10=3 & BITS_4_5=0
{
    ea:$(REGISTER_SIZE) = (RA_OR_ZERO + RB) & 0xfffffffffffffff0;
    xvR = *[ram]:16 ea;
}

:stvx128 xvR, RA_OR_ZERO, RB
    is OP=4 & xvR & RA_OR_ZERO & RB & BITS_6_10=7 & BITS_4_5=0
{
    ea:$(REGISTER_SIZE) = (RA_OR_ZERO + RB) & 0xfffffffffffffff0;
    *[ram]:16 ea = xvR;
}
